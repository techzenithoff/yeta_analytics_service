
USER_SERVICE_URL=https://user-service.production.svc.cluster.local/api/v1   # URL interne de ton user-service
SERVICE_NAME=event-service
ACCESS_TOKEN_EXPIRATION=60
INTERNAL_TOKEN_EXPIRATION=60
JWT_ACCEPTED_AUDIENCES="client,service"


# Dossier contenant les clés publiques
JWT_PUBLIC_KEYS_DIR=config/keys/jwt


# Clé privée pour signer les requêtes inter-service
INTERNAL_PRIVATE_KEY_PATH=config/keys/interservice/private.pem

# Dossier des clés publiques des autres services
INTERNAL_PUBLIC_KEYS_DIR=config/keys/interservice